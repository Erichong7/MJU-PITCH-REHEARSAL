# 배포 서버(EC2) 전용 설정 예시. 서버에서는 ~/pitch.env 로 복사해 값을 채웁니다.
# 실제 값이 든 파일은 깃·노션에 올리지 않습니다. (chmod 600 권장)
# 실행: docker run --env-file ~/pitch.env ...
SPRING_PROFILES_ACTIVE=prod

# RDS (MySQL 8.4)
DB_URL=jdbc:mysql://<RDS엔드포인트>:3306/pitch?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=
DB_PASSWORD=

# OpenAI: 키를 넣은 뒤 LLM_PROVIDER=openai, STT_PROVIDER=whisper 로 전환
OPENAI_API_KEY=
# 재연습 비교 판정이 gpt-4o-mini에서는 불안정해 gpt-4.1-mini 사용 (#41)
OPENAI_MODEL=gpt-4.1-mini
LLM_PROVIDER=fake
STT_PROVIDER=fake

# 녹음 저장: s3 (local은 서버 디스크, 컨테이너의 /app/uploads)
STORAGE_TYPE=s3

# S3 (버킷은 시드니 리전)
# EC2에 S3 권한이 있는 IAM 역할을 붙이면 액세스 키는 넣지 않습니다.
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=

# STORAGE_TYPE=local 일 때만 사용
STORAGE_LOCAL_BASE_URL=http://<서버IP>:8080
STORAGE_LOCAL_SIGNING_SECRET=
